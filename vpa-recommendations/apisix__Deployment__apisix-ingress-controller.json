{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "apisix-ingress-controller",
    "namespace": "apisix"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "ingress-controller",
            "resources": {
              "requests": {
                "cpu": "23m",
                "memory": "125Mi"
              },
              "limits": {
                "cpu": "25m",
                "memory": "125Mi"
              }
            }
          },
          {
            "name": "linkerd-proxy",
            "resources": {
              "requests": {
                "cpu": "12m",
                "memory": "125Mi"
              },
              "limits": {
                "cpu": "12m",
                "memory": "125Mi"
              }
            }
          }
        ]
      }
    }
  }
}
