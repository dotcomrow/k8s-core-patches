{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "hasura-console-proxy",
    "namespace": "graphql"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "hasura-console-upstream",
            "resources": {
              "requests": {
                "cpu": "11m",
                "memory": "64000Ki"
              }
            }
          },
          {
            "name": "linkerd-proxy",
            "resources": {
              "requests": {
                "cpu": "11m",
                "memory": "64000Ki"
              }
            }
          },
          {
            "name": "oauth2-proxy",
            "resources": {
              "requests": {
                "cpu": "11m",
                "memory": "64000Ki"
              }
            }
          },
          {
            "name": "vault-agent",
            "resources": {
              "requests": {
                "cpu": "11m",
                "memory": "64000Ki"
              }
            }
          }
        ]
      }
    }
  }
}
