{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "rancher-turtles-controller-manager",
    "namespace": "cattle-turtles-system"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "manager",
            "resources": {
              "requests": {
                "cpu": "35m",
                "memory": "250Mi"
              },
              "limits": {
                "cpu": "37m",
                "memory": "250Mi"
              }
            }
          }
        ]
      }
    }
  }
}
