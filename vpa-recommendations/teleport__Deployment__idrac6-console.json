{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "idrac6-console",
    "namespace": "teleport"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "idrac6",
            "resources": {
              "requests": {
                "cpu": "35m",
                "memory": "671629701"
              }
            }
          },
          {
            "name": "vault-agent",
            "resources": {
              "requests": {
                "cpu": "12m",
                "memory": "125Mi"
              }
            }
          }
        ]
      }
    }
  }
}
