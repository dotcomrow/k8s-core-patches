{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "hasura",
    "namespace": "graphql"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "hasura",
            "resources": {
              "requests": {
                "cpu": "23m",
                "memory": "297164212"
              }
            }
          },
          {
            "name": "linkerd-proxy",
            "resources": {
              "requests": {
                "cpu": "11m",
                "memory": "87381333"
              }
            }
          },
          {
            "name": "vault-agent",
            "resources": {
              "requests": {
                "cpu": "11m",
                "memory": "87381333"
              }
            }
          }
        ]
      }
    }
  }
}
