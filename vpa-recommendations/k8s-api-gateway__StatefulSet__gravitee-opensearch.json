{
  "apiVersion": "apps/v1",
  "kind": "StatefulSet",
  "metadata": {
    "name": "gravitee-opensearch",
    "namespace": "k8s-api-gateway"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "linkerd-proxy",
            "resources": {
              "requests": {
                "cpu": "12m",
                "memory": "125Mi"
              }
            }
          },
          {
            "name": "opensearch",
            "resources": {
              "requests": {
                "cpu": "182m",
                "memory": "5815202783"
              }
            }
          }
        ]
      }
    }
  }
}
