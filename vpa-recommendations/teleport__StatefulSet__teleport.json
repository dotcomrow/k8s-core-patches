{
  "apiVersion": "apps/v1",
  "kind": "StatefulSet",
  "metadata": {
    "name": "teleport",
    "namespace": "teleport"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "teleport",
            "resources": {
              "requests": {
                "cpu": "35m",
                "memory": "323522422"
              }
            }
          },
          {
            "name": "teleport-guard",
            "resources": {
              "requests": {
                "cpu": "23m",
                "memory": "125Mi"
              }
            }
          }
        ]
      }
    }
  }
}
