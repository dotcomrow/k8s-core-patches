{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "kie-server",
    "namespace": "drools"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "kie-server",
            "resources": {
              "requests": {
                "cpu": "23m",
                "memory": "1168723596"
              }
            }
          },
          {
            "name": "kie-server-proxy",
            "resources": {
              "requests": {
                "cpu": "11m",
                "memory": "87381333"
              }
            }
          },
          {
            "name": "linkerd-proxy",
            "resources": {
              "requests": {
                "cpu": "11m",
                "memory": "87381333"
              }
            }
          }
        ]
      }
    }
  }
}
