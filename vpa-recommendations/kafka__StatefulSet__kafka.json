{
  "apiVersion": "apps/v1",
  "kind": "StatefulSet",
  "metadata": {
    "name": "kafka",
    "namespace": "kafka"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "broker",
            "resources": {
              "requests": {
                "cpu": "63m",
                "memory": "1168723596"
              },
              "limits": {
                "cpu": "83m",
                "memory": "1243705194"
              }
            }
          }
        ]
      }
    }
  }
}
