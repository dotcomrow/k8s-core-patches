              }
            }
          },
          {
            "name": "linkerd-proxy",
            "resources": {
              "requests": {
                "cpu": "11m",
                "memory": "87381333"
              }
            }
          },
          {
            "name": "workbench-proxy",
            "resources": {
              "requests": {
                "cpu": "11m",
                "memory": "87381333"
              }
            }
          }
        ]
      }
    }
  }
}
