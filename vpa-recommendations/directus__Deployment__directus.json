{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "directus",
    "namespace": "directus"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "directus",
            "resources": {
              "requests": {
                "cpu": "23m",
                "memory": "297164212"
              },
              "limits": {
                "cpu": "25m",
                "memory": "332567245"
              }
            }
          },
          {
            "name": "directus-postschema",
            "resources": {
              "requests": {
                "cpu": "11m",
                "memory": "64000Ki"
              },
              "limits": {
                "cpu": "12m",
                "memory": "64000Ki"
              }
            }
          },
          {
            "name": "linkerd-proxy",
            "resources": {
              "requests": {
                "cpu": "11m",
                "memory": "64000Ki"
              },
              "limits": {
                "cpu": "12m",
                "memory": "64000Ki"
              }
            }
          },
          {
            "name": "vault-agent",
            "resources": {
              "requests": {
                "cpu": "11m",
                "memory": "64000Ki"
              },
              "limits": {
                "cpu": "12m",
                "memory": "64000Ki"
              }
            }
          }
        ]
      }
    }
  }
}
