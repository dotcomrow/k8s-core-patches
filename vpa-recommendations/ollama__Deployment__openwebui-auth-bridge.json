{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "openwebui-auth-bridge",
    "namespace": "ollama"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "linkerd-proxy",
            "resources": {
              "requests": {
                "cpu": "12m",
                "memory": "125Mi"
              },
              "limits": {
                "cpu": "14m",
                "memory": "125Mi"
              }
            }
          },
          {
            "name": "openwebui-auth-bridge",
            "resources": {
              "requests": {
                "cpu": "12m",
                "memory": "144645763"
              },
              "limits": {
                "cpu": "14m",
                "memory": "184778691"
              }
            }
          }
        ]
      }
    }
  }
}
