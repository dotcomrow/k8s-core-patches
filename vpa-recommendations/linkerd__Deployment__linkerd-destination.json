{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "linkerd-destination",
    "namespace": "linkerd"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "destination",
            "resources": {
              "requests": {
                "cpu": "23m",
                "memory": "109814751"
              },
              "limits": {
                "cpu": "25m",
                "memory": "122906334"
              }
            }
          },
          {
            "name": "linkerd-proxy",
            "resources": {
              "requests": {
                "cpu": "23m",
                "memory": "64000Ki"
              },
              "limits": {
                "cpu": "39m",
                "memory": "64000Ki"
              }
            }
          },
          {
            "name": "policy",
            "resources": {
              "requests": {
                "cpu": "11m",
                "memory": "64000Ki"
              },
              "limits": {
                "cpu": "12m",
                "memory": "64000Ki"
              }
            }
          },
          {
            "name": "sp-validator",
            "resources": {
              "requests": {
                "cpu": "11m",
                "memory": "64000Ki"
              },
              "limits": {
                "cpu": "12m",
                "memory": "64000Ki"
              }
            }
          }
        ]
      }
    }
  }
}
