{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "kogito-decision-service",
    "namespace": "drools"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "kogito-decision-service",
            "resources": {
              "requests": {
                "cpu": "23m",
                "memory": "1555165137"
              }
            }
          },
          {
            "name": "linkerd-proxy",
            "resources": {
              "requests": {
                "cpu": "12m",
                "memory": "125Mi"
              }
            }
          }
        ]
      }
    }
  }
}
