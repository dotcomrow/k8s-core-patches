{
  "apiVersion": "apps/v1",
  "kind": "DaemonSet",
  "metadata": {
    "name": "grafana-k8s-monitoring-alloy-logs",
    "namespace": "logging-and-monitoring"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "alloy",
            "resources": {
              "requests": {
                "cpu": "4280m",
                "memory": "183046954"
              },
              "limits": {
                "cpu": "4793m",
                "memory": "216762677"
              }
            }
          },
          {
            "name": "config-reloader",
            "resources": {
              "requests": {
                "cpu": "12m",
                "memory": "125Mi"
              },
              "limits": {
                "cpu": "12m",
                "memory": "125Mi"
              }
            }
          }
        ]
      }
    }
  }
}
