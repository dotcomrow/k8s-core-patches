{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "gravitee-gateway",
    "namespace": "k8s-api-gateway"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "gravitee-gateway",
            "resources": {
              "requests": {
                "cpu": "126m",
                "memory": "764046746"
              }
            }
          },
          {
            "name": "vault-agent",
            "resources": {
              "requests": {
                "cpu": "12m",
                "memory": "125Mi"
              }
            }
          }
        ]
      }
    }
  }
}
