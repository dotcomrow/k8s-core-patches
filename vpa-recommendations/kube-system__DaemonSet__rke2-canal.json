{
  "apiVersion": "apps/v1",
  "kind": "DaemonSet",
  "metadata": {
    "name": "rke2-canal",
    "namespace": "kube-system"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "calico-node",
            "resources": {
              "requests": {
                "cpu": "163m",
                "memory": "203699302"
              },
              "limits": {
                "cpu": "238m",
                "memory": "216762658"
              }
            }
          },
          {
            "name": "kube-flannel",
            "resources": {
              "requests": {
                "cpu": "23m",
                "memory": "125Mi"
              },
              "limits": {
                "cpu": "24m",
                "memory": "125Mi"
              }
            }
          }
        ]
      }
    }
  }
}
