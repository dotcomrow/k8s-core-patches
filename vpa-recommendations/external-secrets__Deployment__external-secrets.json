{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "external-secrets",
    "namespace": "external-secrets"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "external-secrets",
            "resources": {
              "requests": {
                "cpu": "25m",
                "memory": "250Mi"
              }
            }
          }
        ]
      }
    }
  }
}
