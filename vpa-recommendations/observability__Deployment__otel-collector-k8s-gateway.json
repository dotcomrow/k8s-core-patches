{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "otel-collector-k8s-gateway",
    "namespace": "observability"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "linkerd-proxy",
            "resources": {
              "requests": {
                "cpu": "23m",
                "memory": "125Mi"
              }
            }
          },
          {
            "name": "otel-collector",
            "resources": {
              "requests": {
                "cpu": "49m",
                "memory": "297164212"
              }
            }
          }
        ]
      }
    }
  }
}
