{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "kyverno-cleanup-controller",
    "namespace": "kyverno"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "controller",
            "resources": {
              "requests": {
                "cpu": "35m",
                "memory": "250Mi"
              }
            }
          }
        ]
      }
    }
  }
}
