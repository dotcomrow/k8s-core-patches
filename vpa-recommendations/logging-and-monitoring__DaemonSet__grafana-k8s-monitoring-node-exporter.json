{
  "apiVersion": "apps/v1",
  "kind": "DaemonSet",
  "metadata": {
    "name": "grafana-k8s-monitoring-node-exporter",
    "namespace": "logging-and-monitoring"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "node-exporter",
            "resources": {
              "requests": {
                "cpu": "25m",
                "memory": "250Mi"
              }
            }
          }
        ]
      }
    }
  }
}
