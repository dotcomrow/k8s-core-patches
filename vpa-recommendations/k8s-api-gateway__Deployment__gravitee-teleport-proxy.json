{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "gravitee-teleport-proxy",
    "namespace": "k8s-api-gateway"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "nginx",
            "resources": {
              "requests": {
                "cpu": "25m",
                "memory": "250Mi"
              },
              "limits": {
                "cpu": "25m",
                "memory": "250Mi"
              }
            }
          }
        ]
      }
    }
  }
}
