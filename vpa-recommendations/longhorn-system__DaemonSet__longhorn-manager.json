{
  "apiVersion": "apps/v1",
  "kind": "DaemonSet",
  "metadata": {
    "name": "longhorn-manager",
    "namespace": "longhorn-system"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "longhorn-manager",
            "resources": {
              "requests": {
                "cpu": "78m",
                "memory": "272061154"
              },
              "limits": {
                "cpu": "104m",
                "memory": "332567147"
              }
            }
          },
          {
            "name": "pre-pull-share-manager-image",
            "resources": {
              "requests": {
                "cpu": "12m",
                "memory": "125Mi"
              },
              "limits": {
                "cpu": "12m",
                "memory": "125Mi"
              }
            }
          }
        ]
      }
    }
  }
}
