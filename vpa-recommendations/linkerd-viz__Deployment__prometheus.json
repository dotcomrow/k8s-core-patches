{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "prometheus",
    "namespace": "linkerd-viz"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "linkerd-proxy",
            "resources": {
              "requests": {
                "cpu": "49m",
                "memory": "125Mi"
              }
            }
          },
          {
            "name": "prometheus",
            "resources": {
              "requests": {
                "cpu": "182m",
                "memory": "1389197403"
              }
            }
          }
        ]
      }
    }
  }
}
