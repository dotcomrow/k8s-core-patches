{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "kafka-connect",
    "namespace": "kafka"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "connect",
            "resources": {
              "requests": {
                "cpu": "35m",
                "memory": "764046746"
              }
            }
          }
        ]
      }
    }
  }
}
