{
  "apiVersion": "apps/v1",
  "kind": "StatefulSet",
  "metadata": {
    "name": "etcd",
    "namespace": "teleport"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "etcd",
            "resources": {
              "requests": {
                "cpu": "49m",
                "memory": "250Mi"
              }
            }
          }
        ]
      }
    }
  }
}
