{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "apisix",
    "namespace": "apisix"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "apisix",
            "resources": {
              "requests": {
                "cpu": "35m",
                "memory": "511772986"
              },
              "limits": {
                "cpu": "52m",
                "memory": "544597966"
              }
            }
          },
          {
            "name": "linkerd-proxy",
            "resources": {
              "requests": {
                "cpu": "23m",
                "memory": "125Mi"
              },
              "limits": {
                "cpu": "24m",
                "memory": "125Mi"
              }
            }
          }
        ]
      }
    }
  }
}
