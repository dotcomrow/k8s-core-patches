{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "ingress-nginx-controller",
    "namespace": "ingress-nginx"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "controller",
            "resources": {
              "requests": {
                "cpu": "49m",
                "memory": "476450463"
              },
              "limits": {
                "cpu": "67m",
                "memory": "507049368"
              }
            }
          }
        ]
      }
    }
  }
}
